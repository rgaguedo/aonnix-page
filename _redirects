# Direcciones anteriores que siguen funcionando (Netlify las resuelve en el borde).
#
# La privacidad de Patitas ID cambió de dirección el 2026-10-05 para llevar el nombre de la
# app. La anterior está en la app de iOS publicada, en su ficha del App Store y en enlaces
# externos: tiene que seguir llevando a la política, no a un error.
/legal/patitas-mascota-privacy     /legal/patitas-id-privacy/          301
/legal/patitas-mascota-privacy/*   /legal/patitas-id-privacy/:splat    301

# El soporte y los términos de Patitas ID cambiaron de dirección el 2026-10-06, por el mismo
# motivo. Las anteriores están en las apps de iOS y de Android ya compiladas, en la ficha del
# App Store y en la de Google Play. El ancla (#eliminar-datos) viaja sola con la redirección.
/support/patitas-mascota     /support/patitas-id/          301
/support/patitas-mascota/*   /support/patitas-id/:splat    301
/terms/patitas-mascota       /terms/patitas-id/            301
/terms/patitas-mascota/*     /terms/patitas-id/:splat      301
